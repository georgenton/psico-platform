# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/psico_dev?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=3001
ALLOWED_ORIGINS="http://localhost:3000"

# Node
NODE_ENV="development"

# Cloudflare R2 (S3-compatible object storage)
#
# For local development use a NON-PRODUCTION bucket and an API token scoped to
# it. Verify it once with:
#   R2_SMOKE_ALLOW=yes-non-production pnpm --filter @psico/api smoke:r2
#
# Account ID: Cloudflare dashboard → R2 → Account ID (top right).
# It is 32 hexadecimal characters; anything shorter is a placeholder and the
# S3 endpoint will fail the TLS handshake rather than return an error you can
# read.
R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2 API tokens: Cloudflare dashboard → R2 → Manage R2 API Tokens.
# Object Read & Write, scoped to the one bucket above.
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Bucket name created in R2 dashboard
R2_BUCKET_NAME="psico-media"
#
# PUBLIC base URL — OPTIONAL, and used for COVERS and CHAPTER ILLUSTRATIONS only.
#
# Leave it UNSET for a private development bucket. That is the right shape for
# proving protected media: audiobook and podcast masters are read through
# presigned GETs and never touch this value, and inventing one here would put a
# URL that 404s forever onto an image. With it unset, image upload refuses
# explicitly and everything protected keeps working.
#
# Uploading an image makes it addressable by this URL immediately, which is
# acceptable for licensed editorial artwork. AUDIOBOOK, PODCAST and TRANSCRIPT
# masters are NOT served this way: they are read through short-lived presigned
# GETs (`StorageService.getSignedUrl`), and must stay that way even though both
# kinds live in the same bucket. Enabling public access on the bucket does not
# change that — it is the READ PATH that protects them, so never store a public
# URL for an audio master.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# Stripe billing
# Secret key: Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret: Stripe dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs: Stripe dashboard → Products → (price ID for each plan)
# PRO monthly: $7.00 USD / month
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
# PRO yearly: $59.00 USD / year (2 months free vs monthly)
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
# B2B monthly: $120.00 USD / month (up to 50 users)
STRIPE_B2B_PRICE_ID="price_..."
