# Dependencies
node_modules/
.pnp
.pnp.js

# Turborepo
.turbo/

# Build outputs
dist/
build/
out/

# Next.js
.next/
apps/web/.next/

# Expo / React Native
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
*.orig.*
web-build/

# NestJS
apps/api/dist/

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
coverage/

# TypeScript
*.tsbuildinfo

# Changesets — .md files must be tracked so `pnpm changeset version` can consume them
!.changeset/*.md

# Local Vercel project linkage
.vercel/
apps/web/.vercel/

# C.3C — the V1 compatibility gate materialises the previous binary here at
# test time (`experience-v1-compat.pg-spec.ts`). Generated, never committed.
apps/api/src/.v1-artifact/

# EEC — binarios de build. Se regeneran con `pnpm eec:c01:build` desde
# content/books/eec/, así que versionarlos sería guardar una copia que puede
# quedar por detrás de su fuente. Los manifiestos y el JSON de FeelVerse SÍ se
# versionan: son revisables en un diff y sirven de contrato.
artifacts/**/print/*.docx
artifacts/**/print/*.pdf
artifacts/**/epub/*.epub
