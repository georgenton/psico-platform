{
  "name": "@psico/types",
  "version": "0.13.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./observability": {
      "import": "./dist/observability-allowlist.mjs",
      "require": "./dist/observability-allowlist.js",
      "types": "./dist/observability-allowlist.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/observability-allowlist.ts --format cjs,esm --dts --clean --no-splitting",
    "dev": "tsup src/index.ts src/observability-allowlist.ts --format cjs,esm --dts --watch --no-splitting",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@psico/eslint-config": "workspace:*",
    "@psico/typescript-config": "workspace:*",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
